<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>Nimbus.Program</StartupObject>
    <ApplicationIcon>Assets\Nimbus.ico</ApplicationIcon>
    <RootNamespace>Nimbus</RootNamespace>
    <AssemblyName>Nimbus</AssemblyName>
    <Product>Nimbus</Product>
    <Version>1.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Paketlerin diğer dillerdeki kaynakları exe'ye girmesin. -->
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Compile Remove="tools/**" />
    <!-- Dosya repoda değildir; derleyen kişinin kendi OAuth istemcisi exe'ye gömülür. -->
    <EmbeddedResource Include="client_secret.json" LogicalName="client_secret.json" Condition="Exists('client_secret.json')" />
    <Resource Include="Assets\Nimbus.ico" />
    <Resource Include="Assets\Nimbus.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.77.0.4301" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- Gömülü istemcisi olmayan release exe'si Google'a giriş yapamaz. -->
  <Target Name="RequireClientSecret" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release' And !Exists('client_secret.json')">
    <Error Text="Release builds need client_secret.json in the project folder. See Build from source in README.md." />
  </Target>

</Project>
