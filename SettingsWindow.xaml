<ui:FluentWindow
    x:Class="Nimbus.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Nimbus"
    Title="{local:Loc SettingsTitle}"
    Width="580"
    Height="630"
    Icon="Assets/Nimbus.ico"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{local:Loc SettingsTitle}" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Globe24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{local:Loc SettingsBrowserTitle}" />
                        <ui:TextBlock x:Name="BrowserText" Appearance="Secondary" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Click="OnChooseBrowserClick" Content="{local:Loc SettingsBrowserChoose}" />
                    <ui:Button x:Name="DefaultBrowserButton" Margin="8,0,0,0" Click="OnDefaultBrowserClick" Content="{local:Loc SettingsBrowserDefault}" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{local:Loc SettingsAutoSaveTitle}" />
                        <ui:TextBlock Appearance="Secondary" Text="{local:Loc SettingsAutoSaveBody}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AutoSaveSwitch" Click="OnAutoSaveClick" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon DocumentSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{local:Loc SettingsReopenTitle}" />
                        <ui:TextBlock Appearance="Secondary" Text="{local:Loc SettingsReopenBody}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="ReopenChoiceBox" Width="230" SelectionChanged="OnReopenChoiceChanged">
                    <ComboBoxItem Content="{local:Loc SettingsReopenAsk}" />
                    <ComboBoxItem Content="{local:Loc SettingsReopenContinue}" />
                    <ComboBoxItem Content="{local:Loc SettingsReopenStartOver}" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Delete24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{local:Loc SettingsCleanupTitle}" />
                        <ui:TextBlock Appearance="Secondary" Text="{local:Loc SettingsCleanupBody}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:NumberBox
                    x:Name="CleanupDaysBox"
                    Width="130"
                    ClearButtonEnabled="False"
                    MaxDecimalPlaces="0"
                    Maximum="3650"
                    Minimum="1"
                    ValueChanged="OnCleanupDaysChanged" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Power24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{local:Loc SettingsAutoStartTitle}" />
                        <ui:TextBlock Appearance="Secondary" Text="{local:Loc SettingsAutoStartBody}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AutoStartSwitch" Click="OnAutoStartClick" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Document24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{local:Loc SettingsFileTypesTitle}" />
                        <ui:TextBlock Appearance="Secondary" Text="{local:Loc SettingsFileTypesBody}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Click="OnLinkFileTypesClick" Content="{local:Loc SettingsFileTypesLink}" />
                    <ui:Button Margin="8,0,0,0" Click="OnUnlinkFileTypesClick" Content="{local:Loc SettingsFileTypesUnlink}" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon CursorClick24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{local:Loc SettingsExplorerMenuTitle}" />
                        <ui:TextBlock Appearance="Secondary" Text="{local:Loc SettingsExplorerMenuBody}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ExplorerMenuSwitch" Click="OnExplorerMenuClick" />
            </ui:CardControl>

            <ui:CardControl Margin="0,8,0,0" Icon="{ui:SymbolIcon LocalLanguage24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{local:Loc SettingsLanguageTitle}" />
                        <ui:TextBlock Appearance="Secondary" Text="{local:Loc SettingsLanguageBody}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="LanguageBox" Width="230" SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="{local:Loc SettingsLanguageSystem}" />
                    <ComboBoxItem Content="Türkçe" />
                    <ComboBoxItem Content="English" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Margin="0,8,0,0" Icon="{ui:SymbolIcon ArrowDownload24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{local:Loc SettingsUpdateTitle}" />
                        <ui:TextBlock x:Name="UpdateText" Appearance="Secondary" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="UpdateModeBox" Width="230" SelectionChanged="OnUpdateModeChanged">
                    <ComboBoxItem Content="{local:Loc SettingsUpdateAsk}" />
                    <ComboBoxItem Content="{local:Loc SettingsUpdateAutomatic}" />
                    <ComboBoxItem Content="{local:Loc SettingsUpdateOff}" />
                </ComboBox>
            </ui:CardControl>

            <ui:TextBlock Margin="0,16,0,8" FontTypography="BodyStrong" Text="{local:Loc SettingsNotificationsTitle}" />

            <ui:Card>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Center" Text="{local:Loc SettingsNotifyProgress}" TextWrapping="Wrap" />
                        <ui:ToggleSwitch x:Name="ProgressSwitch" Grid.Column="1" Click="OnNotificationClick" Tag="Progress" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Center" Text="{local:Loc SettingsNotifyOpened}" TextWrapping="Wrap" />
                        <ui:ToggleSwitch x:Name="OpenedSwitch" Grid.Column="1" Click="OnNotificationClick" Tag="Opened" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Center" Text="{local:Loc SettingsNotifyAutoSaved}" TextWrapping="Wrap" />
                        <ui:ToggleSwitch x:Name="AutoSavedSwitch" Grid.Column="1" Click="OnNotificationClick" Tag="AutoSaved" />
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Center" Text="{local:Loc SettingsNotifyLinkCopied}" TextWrapping="Wrap" />
                        <ui:ToggleSwitch x:Name="LinkCopiedSwitch" Grid.Column="1" Click="OnNotificationClick" Tag="LinkCopied" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Appearance="Disabled" Text="{local:Loc SettingsNotifyConflict}" />
                            <ui:TextBlock Appearance="Tertiary" FontSize="12" Text="{local:Loc SettingsNotifyConflictBody}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="True" IsEnabled="False" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Appearance="Disabled" Text="{local:Loc SettingsNotifySession}" />
                            <ui:TextBlock Appearance="Tertiary" FontSize="12" Text="{local:Loc SettingsNotifySessionBody}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="True" IsEnabled="False" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Appearance="Disabled" Text="{local:Loc SettingsNotifyErrors}" />
                            <ui:TextBlock Appearance="Tertiary" FontSize="12" Text="{local:Loc SettingsNotifyErrorsBody}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="True" IsEnabled="False" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
