<ui:FluentWindow
    x:Class="Nimbus.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Nimbus Ayarları"
    Width="580"
    Height="630"
    Icon="Assets/Nimbus.ico"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Nimbus Ayarları" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Globe24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Tarayıcı" />
                        <ui:TextBlock x:Name="BrowserText" Appearance="Secondary" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Click="OnChooseBrowserClick" Content="Seç…" />
                    <ui:Button x:Name="DefaultBrowserButton" Margin="8,0,0,0" Click="OnDefaultBrowserClick" Content="Varsayılan" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Otomatik geri kaydet" />
                        <ui:TextBlock Appearance="Secondary" Text="Son 24 saatte açılan belgelerdeki Google düzenlemelerini bilgisayara yazar." TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AutoSaveSwitch" Click="OnAutoSaveClick" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon DocumentSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Google kopyası farklıysa" />
                        <ui:TextBlock Appearance="Secondary" Text="Dosya yeniden açıldığında ne yapılsın?" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="ReopenChoiceBox" Width="230" SelectionChanged="OnReopenChoiceChanged">
                    <ComboBoxItem Content="Her seferinde sor" />
                    <ComboBoxItem Content="Kaldığın yerden devam et" />
                    <ComboBoxItem Content="Baştan başla" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Delete24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Eski dosyaları temizle" />
                        <ui:TextBlock Appearance="Secondary" Text="Kaç gündür değişmeyen dosyalar çöp kutusuna taşınsın?" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:NumberBox
                    x:Name="CleanupDaysBox"
                    Width="130"
                    ClearButtonEnabled="False"
                    MaxDecimalPlaces="0"
                    Maximum="3650"
                    Minimum="1"
                    ValueChanged="OnCleanupDaysChanged" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Power24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Windows ile başlat" />
                        <ui:TextBlock Appearance="Secondary" Text="Oturum açınca Nimbus tepside çalışmaya başlar." TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AutoStartSwitch" Click="OnAutoStartClick" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Document24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Dosya türleri" />
                        <ui:TextBlock Appearance="Secondary" Text="Office dosyalarını Nimbus ile açın." TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Click="OnLinkFileTypesClick" Content="Bağla…" />
                    <ui:Button Margin="8,0,0,0" Click="OnUnlinkFileTypesClick" Content="Bağlantıyı kaldır" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon CursorClick24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Sağ tık menüsü" />
                        <ui:TextBlock Appearance="Secondary" Text="Explorer menüsüne &quot;Nimbus ile aç&quot; ekler." TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ExplorerMenuSwitch" Click="OnExplorerMenuClick" />
            </ui:CardControl>

            <ui:CardControl Margin="0,8,0,0" Icon="{ui:SymbolIcon ArrowDownload24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Güncelleme" />
                        <ui:TextBlock x:Name="UpdateText" Appearance="Secondary" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="UpdateModeBox" Width="230" SelectionChanged="OnUpdateModeChanged">
                    <ComboBoxItem Content="Sor" />
                    <ComboBoxItem Content="Otomatik güncelle" />
                    <ComboBoxItem Content="Kapalı" />
                </ComboBox>
            </ui:CardControl>

            <ui:TextBlock Margin="0,16,0,8" FontTypography="BodyStrong" Text="Bildirimler" />

            <ui:Card>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Center" Text="Yükleniyor ve ilerleme" TextWrapping="Wrap" />
                        <ui:ToggleSwitch x:Name="ProgressSwitch" Grid.Column="1" Click="OnNotificationClick" Tag="Progress" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Center" Text="Açıldı ve önceki kopya" TextWrapping="Wrap" />
                        <ui:ToggleSwitch x:Name="OpenedSwitch" Grid.Column="1" Click="OnNotificationClick" Tag="Opened" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Center" Text="Otomatik kayıt güncellendi" TextWrapping="Wrap" />
                        <ui:ToggleSwitch x:Name="AutoSavedSwitch" Grid.Column="1" Click="OnNotificationClick" Tag="AutoSaved" />
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Center" Text="Bağlantı kopyalandı" TextWrapping="Wrap" />
                        <ui:ToggleSwitch x:Name="LinkCopiedSwitch" Grid.Column="1" Click="OnNotificationClick" Tag="LinkCopied" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Appearance="Disabled" Text="Çakışma" />
                            <ui:TextBlock Appearance="Tertiary" FontSize="12" Text="Her zaman açık: seçiminiz olmadan dosya yazılmaz." TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="True" IsEnabled="False" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Appearance="Disabled" Text="Oturum düştü" />
                            <ui:TextBlock Appearance="Tertiary" FontSize="12" Text="Her zaman açık: yeniden giriş yapılmadan eşitleme durur." TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="True" IsEnabled="False" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Appearance="Disabled" Text="Hatalar" />
                            <ui:TextBlock Appearance="Tertiary" FontSize="12" Text="Her zaman açık: başarısız bir işlemden haberiniz olur." TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="True" IsEnabled="False" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
