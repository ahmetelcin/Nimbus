<ui:FluentWindow
    x:Class="Nimbus.SignInWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Nimbus"
    Width="420"
    Height="340"
    Icon="Assets/Nimbus.ico"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Nimbus" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="32,0,32,32" VerticalAlignment="Center">
            <Image Width="56" Height="56" Margin="0,0,0,16" Source="Assets/Nimbus.png" />
            <ui:TextBlock
                Margin="0,0,0,8"
                FontTypography="Subtitle"
                Text="Office dosyalarınızı Google'da açın"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <ui:TextBlock
                Margin="0,0,0,24"
                Appearance="Secondary"
                Text="Dosyalar yalnızca kendi Google Drive'ınıza yüklenir. Nimbus, yalnızca kendi oluşturduğu dosyaları görebilir."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <ui:Button
                x:Name="SignInButton"
                HorizontalAlignment="Center"
                Appearance="Primary"
                Click="OnSignInClick"
                Content="Google ile giriş yap" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
